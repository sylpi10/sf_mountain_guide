<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
  <head>
    <meta charset="UTF-8">
    <meta name="google-site-verification" content="t01FJSVSZtLHENopAufACNFJq6S9ejlLoqxpdm9Ztm8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Description (155–160 chars idéal) #}
    {% set page_description %}{% block description %}{% trans %}IFMGA mountain guide in Briançon: mountaineering, ski touring, rock and ice climbing in the Écrins, Clarée and Queyras. Tailor-made trips for all levels.{% endtrans %}{% endblock %}{% endset %}
    {% set page_description = page_description|striptags|trim|replace({'\n': ' '})|slice(0, 160) %}
    <meta name="description" content="{{ page_description }}">
    {% block robots %}{% endblock %}

		<title>
			{% block title %}
				{% trans %}
				High Mountain guide
				{% endtrans %}
			{% endblock %}
		</title>
		{% set canonical_page = app.request.query.get('page') %}
		<link rel="canonical" href="{{ site_url ~ app.request.pathInfo ~ (canonical_page and canonical_page > 1 ? '?page=' ~ canonical_page : '') }}">
		<meta property="og:type" content="{% block og_type %}website{% endblock %}">
		<meta property="og:site_name" content="Directicimes">
		<meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_GB' : 'fr_FR' }}">
		<meta property="og:url" content="{{ site_url ~ app.request.pathInfo }}">
		<meta property="og:title" content="{{ block('title')|striptags|trim }}">
		<meta property="og:description" content="{{ page_description }}">
		<meta property="og:image" content="{% block og_image %}{{ site_url ~ asset('images/bg1-1280.webp') }}{% endblock %}">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ block('title')|striptags|trim }}">
		<meta name="twitter:description" content="{{ page_description }}">
		{# Données structurées : nom, adresse, téléphone alignés sur la fiche Google Business Profile ;
		   la description reprend le texte de présentation modifiable en admin #}
		{% set guide_description = site_text('home_intro')|join(' ') ?: page_description %}
		<script type="application/ld+json">
		{{ {
			'@context': 'https://schema.org',
			'@type': 'SportsActivityLocation',
			'@id': site_url ~ '/#guide',
			'name': 'Yoann GEORGES - Guide de Haute Montagne - directicimes',
			'alternateName': 'Directicimes',
			'url': site_url ~ '/',
			'image': site_url ~ asset('images/logo_big.webp'),
			'logo': site_url ~ asset('images/logo_big.webp'),
			'description': guide_description,
			'telephone': contact_phone|replace({' ': ''}),
			'address': {
				'@type': 'PostalAddress',
				'streetAddress': '12D Rue des 4 Vents',
				'addressLocality': 'Villar-Saint-Pancrace',
				'postalCode': '05100',
				'addressRegion': 'Hautes-Alpes',
				'addressCountry': 'FR',
			},
			'openingHoursSpecification': {
				'@type': 'OpeningHoursSpecification',
				'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
				'opens': '00:00',
				'closes': '23:59',
			},
			'areaServed': ['Serre Chevalier', 'Montgenèvre', 'Vallée de la Clarée', 'Briançon', 'Massif des Écrins', 'Queyras', 'Hautes-Alpes'],
			'knowsAbout': ['Alpinisme', 'Ski de randonnée', 'Ski hors-piste', 'Escalade', 'Grandes voies', 'Cascade de glace'],
			'sameAs': ['https://facebook.com/directicimes/', 'https://instagram.com/directicimes'],
			'founder': {
				'@type': 'Person',
				'name': 'Yoann Georges',
				'jobTitle': 'Guide de haute montagne',
				'hasCredential': {
					'@type': 'EducationalOccupationalCredential',
					'credentialCategory': 'Diplôme de guide de haute montagne UIAGM / IFMGA',
					'recognizedBy': {'@type': 'Organization', 'name': "École nationale de ski et d'alpinisme (ENSA)"},
				},
			},
		}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}
		</script>
		{# favicon : SVG net à toutes les tailles, ICO 16/32/48 en repli (Google exige un multiple de 48 px) #}
		<link rel="icon" href="{{ asset('favicon.ico') }}" sizes="48x48">
		<link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
		<link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
		<link rel="manifest" href="{{ asset('site.webmanifest') }}">
		<meta name="theme-color" content="#0b0b25">
		<link rel="stylesheet" href="{{asset('css/style.css')}}"> {% block stylesheets %}{% endblock %}

		{% block head_extra %}{% endblock %}
		</head>
		<body class="{% block body_class %}detail-page{% endblock %}">
			<header id="top">
				<nav class="navbar navbar-expand-lg navbar-dark menu">
					<div class="container-fluid">

						<button class="navbar-toggler ml-auto" type="button" aria-controls="navbarCollapse" aria-expanded="false" aria-label="{% trans %}Toggle navigation{% endtrans %}">
							<span class="navbar-toggler-icon"></span>
						</button>

						<div class="collapse navbar-collapse navs-wrapper" id="navbarCollapse">

							<div class="logo">
								<a class="navbar-brand" href="{{path('home')}}">
									<img src="{{asset('images/logo.webp')}}" width="110" height="110" id="logo" alt="Logo Directicimes" title=" {% trans %} Home {% endtrans %} ">
								</a>
							</div>

							<ul class="navbar-nav nav-primary">
								<li class="nav-item active">
									<a class="nav-link" href="{{path('home')}}" title="{% trans %} Home {% endtrans %}">
										{% trans %}
										Home
										{% endtrans %}
										<span class="sr-only">(current)</span>
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{path('home', {'_fragment':'contact-form'})}}" title="{% trans %}To get in touch with me{% endtrans %}">Contact
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{path('about')}}" title="{% trans %} Get to know me {% endtrans %}">{% trans %}
										About
										{% endtrans %}</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{path('pricing')}}" title="{% trans %}See my prices{% endtrans %}">{% trans %}Prices{% endtrans %}</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{path('blog')}}" title="{% trans %}See our last adventures{% endtrans %}">Blog</a>
								</li>


								{% if is_granted('ROLE_ADMIN') %}
									<li class="nav-item">
										<a class="nav-link text-warning" href="{{path('admin')}}" title="admin">Admin</a>
									</li>
								{% endif %}


								{% for locale in locales %}
									{% if locale != app.request.locale %}
										<li class="nav-item">
											<a href="{{path('change-locale', {'locale': locale})}}" class="nav-link" title="{% trans %} Passer en Français {% endtrans %}">
												<img src="{{asset('images/' ~locale~ '.png')}}" alt="{{locale}}" width="24">
											</a>
										</li>
									{% endif %}
								{% endfor %}

							</ul>

							<div class="right-nav">

								{% if not app.user %}
									<li class="nav-item">
										<a class="nav-link" href="{{path('login')}}" title="{% trans %} Login to your account {% endtrans %}">{% trans %}
											Login
											{% endtrans %}</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" href="{{path('register')}}" title="{% trans %} Create an account {% endtrans %}">{% trans %}
											Register
											{% endtrans %}</a>
									</li>
								{% endif %}
								{% if displayBtn|default(false) %}
									<li class="nav-item">
										<a class="nav-link" href="{{path('newsletter')}}" title="{% trans %} Subscribe to our Newsletter {% endtrans %}">Newsletter</a>
									</li>
								{% endif %}
								{% if app.user %}
									<li class="nav-item">
										<a class="nav-link text-danger" title="logout" href=" {{path('logout')}} ">{% trans %}
											Logout
											{% endtrans %}</a>
									</li>
								{% endif %}
								{% if app.user %}
									<li class="logged-as">
										{{ icon('user') }}
										{{app.user}}
									</li>
								{% endif %}
							</div>

						</div>
					</div>
				</nav>
			</header>

			{# back to top #}
			<a href="#top" id="" title="{% trans %} Back to Top {% endtrans %}">
				{{ icon('arrow-up', 'back-top') }}
			</a>

			{% block body %}{% endblock %}
			{% block javascripts %}{% endblock %}
			<script src="{{asset('js/script.js')}}" defer></script>
		</body>
	</html>
