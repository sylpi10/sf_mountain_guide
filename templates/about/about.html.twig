{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}
	About
	{% endtrans %}
{% endblock %}
{% block description %}
	{% trans %}About Yoann Georges, IFMGA mountain guide based in Briançon: his background, his passion for the mountains and his approach to guiding in the Écrins and beyond.{% endtrans %}
{% endblock %}
{% block body_class %}base-page
{% endblock %}
{% block body %}

	<main class="main-about">
		<div class="container about-container">
			<div class="about-me">
				<div class="about-text">
					{% for locale in locales %}
						{% if locale == app.request.locale %}
							{% if locale =='fr' %}
								<h1>{{about.whoTitle}}</h1>
								<div>
									{{about.whoText|raw}}
								</div>
							{% endif %}
							{% if locale =='en' %}
								<h1>{{about.whoEnglishTitle}}</h1>
								<div class="">
									{{about.whoEnglishText|raw}}
								</div>
							{% endif %}
						{% endif %}
					{% endfor %}
				</div>
				<div class="about-pic">
					{% for slot, fallback in {
						about_1: {src: asset('images/about-me.jpg'), alt: 'Photo de guide de montagne en falaise'},
						about_2: {src: asset('images/about-me3.jpg'), alt: 'Photo de guide de montagne en campement'},
					} %}
						{% set pic = site_image(slot) %}
						{% if pic %}
							<img src="{{ pic.src }}" srcset="{{ pic.srcset }}" sizes="(max-width: 540px) 100vw, 500px" alt="{{ pic.alt ?: fallback.alt }}" class="img-fluid shadow" width="500" height="{{ (500 * pic.height / pic.width)|round }}">
						{% else %}
							<img src="{{ fallback.src }}" alt="{{ fallback.alt }}" class="img-fluid shadow" width="500">
						{% endif %}
					{% endfor %}
				</div>
			</div>

		</div>
	</main>
	<div class="" id="">
		{% include "footer.html.twig" %}</div>
{% endblock %}
