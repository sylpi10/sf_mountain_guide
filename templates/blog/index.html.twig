{% extends 'base.html.twig' %}

{% block title %}
	Blog – Directicimes, guide de haute montagne à Briançon
{% endblock %}
{% block description %}
	Récits de sorties, conseils et actualités d'un guide de haute montagne à Briançon : alpinisme, escalade, ski de randonnée, cascade de glace.
{% endblock %}

{% block body_class %}base-page
{% endblock %}
{% block body %}
	<div class="container blog-container">
		<div class="mt-5 p-5 article-wrapper">
			<h1>Blog</h1>
			<hr>
			{% for article in articles %}
				<div class="article">

					{% for locale in locales %}
						{% if locale == app.request.locale %}
							{% if locale == 'fr' %}
								<h2>{{article.title|title}}</h2>
							{% else %}
								<h2>{{article.englishTitle|title}}</h2>
							{% endif %}
							<span class="date-loc">
								{{ icon('calendar') }}
								{{ article.createdAt|date("m/d/Y", "Europe/Paris")}},
								{{ icon('map-marker') }}
								{{article.location}}
							</span>
							<div class="article-content">
								{% if locale == 'fr' %}
									<p>{{ article.content|plain_text(300) }}
										<a href="{{ path('blog_detail', {id: article.id, slug: article.slug}) }}" title="details">
											[...]
											{% trans %}Read the post{% endtrans %}
										</a>
									</p>
								{% else %}
									<p>{{ article.englishContent|plain_text(300) }}
										<a href="{{ path('blog_detail', {id: article.id, slug: article.slug}) }}" title="details">
											[...]
											{% trans %}Read the post{% endtrans %}
										</a>
									</p>
								{% endif %}
							{% endif %}

						{% endfor %}
						{% if article.image %}
							<img src="{{asset('uploads/' ~ article.image)}}" alt="{{article.title|title }}" class="d-block img-fluid" width="140" height="140">
						{% endif %}
					</div>


					{# <div class="read-more">
																																																																																																					<a href="{{ path('blog_detail', {id: article.id, slug: article.slug}) }}" title="details">
																																																																																																						{% trans %}Read the post{% endtrans %}
																																																																																																					</a>
																																																																																																				</div> #}

				</div>

				<hr class="bg-dark">


			{% endfor %}

			<div class="navigation shadow">
				{{ knp_pagination_render(articles) }}
			</div>
		</div>


	</div>

	<div class="" id="">
		{% include "footer.html.twig" %}
	</div>
{% endblock %}
