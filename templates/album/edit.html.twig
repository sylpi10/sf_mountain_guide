{% extends 'base.html.twig' %}

{% block stylesheets %}
    {# pages d'administration : Bootstrap et Font Awesome uniquement ici #}
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z" crossorigin="anonymous">
{% endblock %}

{% block title %}Edit Album{% endblock %}

{% block body %}
<div class="container mt-5 p-5 shadow">
    
    <h1>Modifier l' Album: "{{album.title}}"</h1>
    <hr>

    <a href="{{ path('album_index') }}" class="btn btn-info my-3">
        <i class="fas fa-arrow-circle-left mr-2"></i>Retour à la liste</a>

  
    {{ include('album/_form.html.twig',  {'button_label': 'Sauver les changements'})}}
    {{ include('album/_delete_form.html.twig')}}
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{asset('js/images.js')}}"></script>
{% endblock %}