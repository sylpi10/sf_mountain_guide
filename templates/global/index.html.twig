{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Mountain guide in Briançon, French Alps – Ski touring, mountaineering{% endtrans %}
{% endblock %}
{% block description %}
	{% trans %}IFMGA mountain guide in Briançon: off-piste skiing and ski touring in Serre Chevalier, Montgenèvre and the Clarée valley. Tailor-made days for all levels.{% endtrans %}
{% endblock %}

{% block og_image %}{% set hero = site_image('hero') %}{{ site_url ~ (hero ? hero.src : asset('images/bg1-1280.webp')) }}{% endblock %}

{% block head_extra %}
  {% set hero = site_image('hero') %}
  {% if hero %}
    {% set hero_mobile = site_image('hero_mobile') ?? hero %}
    <link rel="preload" as="image" imagesrcset="{{ hero_mobile.srcset }}" imagesizes="100vw" media="(max-width: 768px)">
    <link rel="preload" as="image" imagesrcset="{{ hero.srcset }}" imagesizes="100vw" media="(min-width: 769px)">
  {% else %}
    <link rel="preload" as="image" href="/images/bg1-mobile-480.webp" media="(max-width: 480px)">
    <link rel="preload" as="image" href="/images/bg1-mobile.webp" media="(max-width: 768px)">
    <link rel="preload" as="image" href="/images/bg1-1280.webp" media="(min-width: 769px)">
  {% endif %}
{% endblock %}

{% block body_class %}base-page home-page
{% endblock %}
{% block body %}

<div class="hero hero-area">
  {% set hero = site_image('hero') %}
  {% if hero %}
    {% set hero_mobile = site_image('hero_mobile') ?? hero %}
    <picture>
      <source type="image/webp" media="(min-width: 769px)" srcset="{{ hero.srcset }}" sizes="100vw">
      <source type="image/webp" media="(max-width: 768px)" srcset="{{ hero_mobile.srcset }}" sizes="100vw">
      <img
        src="{{ hero_mobile.src }}"
        width="{{ hero_mobile.width }}"
        height="{{ hero_mobile.height }}"
        fetchpriority="high"
        decoding="async"
        alt="{{ hero.alt ?: 'Mountain landscape in Briançon'|trans }}"
        class="hero-img"
      >
    </picture>
  {% else %}
    <picture>
      {# Desktop #}
      <source
        type="image/webp"
        media="(min-width: 769px)"
        srcset="
          {{ asset('images/bg1-1280.webp') }} 1280w,
          {{ asset('images/bg1.webp') }} 1920w
        "
        sizes="100vw"
      >

      {# Mobile #}
      <source
        type="image/webp"
        media="(max-width: 768px)"
        srcset="
          {{ asset('images/bg1-mobile-480.webp') }} 480w,
          {{ asset('images/bg1-mobile.webp') }} 768w
        "
        sizes="100vw"
      >

      <img
        src="{{ asset('images/bg1-mobile-480.webp') }}"
        width="480"
        height="720"
        fetchpriority="high"
        decoding="async"
        alt="{% trans %}Mountain landscape in Briançon{% endtrans %}"
        class="hero-img"
      >
    </picture>
  {% endif %}


  <div class="hero-content hero-overlay">
    {# un seul bloc dans la grille du hero : le sous-titre reste collé au H1 #}
    <div class="hero-heading">
      <h1 class="main-title">{% trans %}Mountain guide in Briançon, French Alps{% endtrans %}</h1>
      <p class="hero-subtitle">{% trans %}Ski touring, mountaineering, rock climbing{% endtrans %}</p>
    </div>
    <a href="{{ path('home', {'_fragment':'disciplines'}) }}" class="btn more-link">
      {% trans %}Discover the activities{% endtrans %}
    </a>
  </div>
</div>

	{# end hero #}

	<!-- // anchor for more link -->
	<div id="disciplines"></div>

	{# // disciplines section #}

	<main class="disciplines-list container">
		<div class="presentation">
			{% for paragraph in site_text('home_intro') %}
				<p>{{ paragraph|nl2br }}</p>
			{% else %}
				<p>{% trans %}Montain Guide in Briançon, I have many mountain activities to show you:{% endtrans %}</p>
			{% endfor %}
		</div>

		{# mise en avant de la saison en cours (mois réglés en admin, comme l'onglet ouvert de la page tarifs) #}
		{% set is_winter = season.value == 'winter' %}
		<section class="season-highlight" aria-labelledby="season-title">
			<p class="season-kicker">{{ is_winter ? 'Winter season'|trans : 'Summer season'|trans }}</p>
			<h2 id="season-title">{{ is_winter ? 'This winter in the mountains'|trans : 'This summer in the mountains'|trans }}</h2>
			<div class="season-cards">
				{% for disci in disciplines %}
					<twig:DisciplineCard :discipline="disci" />
				{% endfor %}
			</div>
		</section>

		{% if outings %}
			<section class="season-outings" aria-labelledby="outings-title">
				<h2 id="outings-title">{% trans %}Outings not to be missed{% endtrans %}</h2>
				<div class="outing-grid">
					{% for outing in outings %}
						<twig:OutingCard :outing="outing" :showDiscipline="true" />
					{% endfor %}
				</div>
			</section>
		{% endif %}

		<p class="season-more">
			<a class="btn more-link" href="{{ path('activities') }}">{% trans %}All activities{% endtrans %}</a>
			<a class="season-other" href="{{ path('activities', {'_fragment': is_winter ? 'ete' : 'hiver'}) }}">{{ is_winter ? 'See summer activities'|trans : 'See winter activities'|trans }} &rarr;</a>
		</p>
	</main>

	{# </main> #}


	<twig:Reviews />

	<div class="contact" id="contact-form">
		{% include "contact.html.twig" %}
		{% include "footer.html.twig" %}
	</div>
{% endblock %}
