{% extends 'base.html.twig' %}
{% block title %}
	{% set seo_title = (app.request.locale == 'en' ? discipline.seoTitleEn : null) ?: discipline.seoTitle %}
	{% if seo_title %}{{ seo_title }}{% elseif app.request.locale == 'fr' %}{{ discipline.title }} - Directicimes{% else %}{{ discipline.englishTitle }} - Directicimes{% endif %}
{% endblock %}
{% block description %}
	{% if app.request.locale == 'fr' %}{{ discipline.content|plain_text }}{% else %}{{ discipline.englishContent|plain_text }}{% endif %}
{% endblock %}

{% block head_extra %}
	{# image de fond : la plus petite déclinaison par défaut, une plus grande dès que l'écran la dépasse #}
	{% set bg = upload_image(discipline.imageDetail, constant('App\\Entity\\Discipline::IMAGE_WIDTHS')['discipline_images_detail']) %}
	{% if bg %}
		<style>
			{% set previous = null %}
			{% for width, url in bg.variants|default({0: bg.src}) %}
				{% if previous %}@media (min-width: {{ previous + 1 }}px) { {% endif %}
				.discipline-bg { background-image: url('{{ url }}'); }
				{% if previous %}}{% endif %}
				{% set previous = width %}
			{% endfor %}
		</style>
	{% endif %}
{% endblock %}
{% block body %}
	<main class="details">
		{% for locale in locales %}
			{% if locale == app.request.locale %}
				{# <div class="disciplines {{discipline|replace({" ":" -"})|lower|trim}}" id=""> #}
				<div data-jarallax data-speed="0.4" class="disciplines discipline-bg jarallax {{discipline.slug|lower}}" id="">
					<div class=" container-fluid">
						<div class="text-wrapper">
							<div class="text">

								{% if locale =='fr' %}
									<h1>{{discipline.title}}</h1>
								{% endif %}
								{% if locale =='en' %}
									<h1>{{discipline.englishTitle}}</h1>
								{% endif %}

								<hr class="under-title">

								{% if locale =='fr' %}
									<div>{{discipline.content|replace({'<h1>': '<h2>', '</h1>': "</h2>"})|raw }}</div>
								{% endif %}
								{% if locale =='en' %}
									<div>{{discipline.englishContent|replace({'<h1>': '<h2>', '</h1>': "</h2>"})|raw }}</div>
								{% endif %}

								<a href="#contact-form" class="btn contact-btn goto-contact">{% trans %}Book{% endtrans %}</a>
							</div>

							<div class="info-details">
								<div class="nb-persons">
									{{ icon('users') }}
									{% if locale == 'fr' %}
										<span>{{discipline.persNumber|raw}}</span>
									{% else %}
										<span>{{discipline.englishNbPers|raw}}</span>
									{% endif %}
								</div>
								<hr>
								<div class="duration">
									{{ icon('clock') }}
									{% if locale == 'fr' %}
										<span>{{discipline.duration|raw}}</span>
									{% else %}
										<span>{{discipline.englishDuration|raw}}</span>
									{% endif %}
								</div>
								<hr>
								{% if discipline.location %}
									<div class="place">
										{{ icon('map') }}
										{% if locale == 'fr' %}
											<span>{{discipline.location|raw}}</span>
										{% else %}
											<span>{{discipline.englishLocation|raw}}</span>
										{% endif %}
									</div>
								{% endif %}
								<hr>
								<a class="price" href="{{ path('pricing') }}" title="{% trans %}See all prices{% endtrans %}">
									{{ icon('tag') }}
									{% if locale == 'fr' %}
										<span>{{discipline.price|raw}}</span>
									{% else %}
										<span>{{discipline.englishPrice|raw}}</span>
									{% endif %}
									<span class="price-more">{% trans %}See all prices{% endtrans %}</span>
								</a>
							</div>
						</div>

					</div>
				</div>
			{% endif %}
		{% endfor %}
	</main>
	<div class="list-details">

		<div class="disciplines-list">

			{# titre invisible : évite le saut h1 -> h3 des cartes quand le texte n'a pas de h2 #}
			<h2 class="sr-only">{% trans %}Other activities{% endtrans %}</h2>
			{% for disci in disciplines|filter(d => d.id != discipline.id) %}
				<twig:DisciplineCard :discipline="disci" />
			{% endfor %}

		</div>
	</div>

	<div class="contact" id="contact-form">
		{% include "contact.html.twig" %}
		{% include "footer.html.twig" %}
	</div>
{% endblock %}
