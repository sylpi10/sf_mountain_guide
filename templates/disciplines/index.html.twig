{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Mountain activities in Briançon{% endtrans %} - {% trans %}High Mountain guide{% endtrans %}
{% endblock %}
{% block description %}
	{% trans %}Mountaineering, rock climbing, off-piste skiing and ice climbing with a mountain guide in Briançon: beginner or experienced, tailor-made trips in small groups or private.{% endtrans %}
{% endblock %}
{% block body_class %}base-page
{% endblock %}
{% block body %}
	{% set is_en = app.request.locale == 'en' %}

	<main class="activities-page">
		<div class="container activities-container">
			<h1>{% trans %}Mountain activities in Briançon{% endtrans %}</h1>

			<div class="activities-intro">
				{% for paragraph in site_text('activities_intro') %}
					<p>{{ paragraph }}</p>
				{% endfor %}
			</div>

			<div class="activities-list">
				{% for disci in disciplines %}
					{% set title = is_en ? disci.englishTitle : disci.title %}
					{% set teaser = (is_en ? disci.teaserEn : null) ?: disci.teaser %}
					{% set url = path('detail', {id: disci.id, slug: disci.slug}) %}
					<article class="activity">
						<a class="activity-image" href="{{ url }}" tabindex="-1" aria-hidden="true">
							<img src="{{ asset('uploads/' ~ disci.image) }}" alt="" loading="{{ loop.first ? 'eager' : 'lazy' }}">
						</a>
						<div class="activity-body">
							<h2><a href="{{ url }}">{{ title }}</a></h2>
							{% if teaser %}
								<p class="activity-teaser">{{ teaser }}</p>
							{% endif %}
							<twig:DisciplineInfos :discipline="disci" />
							<a class="btn more-link" href="{{ url }}">{% trans %}Discover the activity{% endtrans %}</a>
						</div>
					</article>
				{% endfor %}
			</div>

			<div class="activities-cta">
				<p>{% trans %}A project in mind? I will send you a personalised quote.{% endtrans %}</p>
				<a class="btn more-link" href="{{ path('home', {'_fragment': 'contact-form'}) }}">{% trans %}Contact me{% endtrans %}</a>
			</div>
		</div>
	</main>

	<div>
		{% include "footer.html.twig" %}
	</div>
{% endblock %}
