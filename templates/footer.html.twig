<footer class="footer mt-5">
	<div class="container">
		<div class="about-footer">

			<div class="footer-infos">
				<p>Yoann Georges</p>
				<p>Guide de Haute Montagne</p>

				{% if area_pages() %}
					<div class="footer-areas">
						{% trans %}Areas:{% endtrans %}
						{% for area in area_pages() %}
							<a href="{{ path('area_page', {slug: area.slug}) }}" title="{{ (app.request.locale == 'en' ? area.titleEn : null) ?: area.title }}">{{ area.name }}</a>
						{% endfor %}
					</div>
				{% endif %}


			</div>
			<div class="images-wrapper">
				<img src="{{asset('images/logo-uiagm.webp')}}" alt="Logo uiagm" width="110">
				<img src="{{asset('images/logo.webp')}}" alt="Logo Directicimes" width="110">
			</div>
			<div class="coords-infos">
				<ul class="coords">
					<li>
						{{ icon('map-marker') }}
						Briançon</li>
					<li>
						{{ icon('phone') }}
						<a href="tel:{{ contact_phone|replace({' ': ''}) }}" title="Téléphone">{{ contact_phone }}</a>
					</li>
					<li>
						{{ icon('envelope') }}
						<a href="mailto:georgesyn@gmail@@com" onmouseover="this.href=this.href.replace('@@','.')" title="E-mail">georgesyn@gmail.com</a>
					</li>

					<li>
						<!-- Social icons -->
						<div class="social-links">
							<a href="https://facebook.com/directicimes/" target="_blank" title="Facebook">
								{{ icon('facebook', 'mr-3') }}
							</a>
							<a href="https://instagram.com/directicimes" target="_blank" title="Instagram">
								{{ icon('instagram', 'mr-3') }}
							</a>
						</div>
					</li>
				</ul>

				{% if legal_pages() %}
					<span class="footer-legal">
						{% for legal in legal_pages() %}
							<a href="{{ path('legal_page', {slug: legal.slug}) }}">{{ (app.request.locale == 'en' ? legal.titleEn : null) ?: legal.title }}</a>
						{% endfor %}
					</span>
				{% endif %}
			</div>
		</div>
		<div class="footer-copyright">
			© 2020 - {{ 'now'|date('Y') }} Copyright -
			<a href="https://sylvainpillet.com/" target="_blank" title="Portfolio">
				S Pillet
			</a>

		</div>
	</div>
</footer>
