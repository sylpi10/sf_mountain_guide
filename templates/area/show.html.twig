{% extends 'base.html.twig' %}

{% block title %}
	{% set seo_title = app.request.locale == 'en' ? page.seoTitleEn : page.seoTitle %}
	{{ seo_title ?: ((app.request.locale == 'en' ? page.titleEn : null) ?: page.title) ~ ' - Directicimes' }}
{% endblock %}
{% block description %}
	{{ (app.request.locale == 'en' ? page.metaDescriptionEn : null) ?: page.metaDescription ?: page.title }}
{% endblock %}
{% block body_class %}base-page
{% endblock %}
{# vignette Google / réseaux sociaux : portrait du guide plutôt que le paysage par défaut #}
{% block og_image %}{{ site_url ~ asset('images/profile-share.jpg') }}{% endblock %}
{% block head_extra %}
	<script type="application/ld+json">
	{{ {
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'url': site_url ~ app.request.pathInfo,
		'name': block('title')|striptags|trim,
		'primaryImageOfPage': site_url ~ asset('images/profile-share.jpg'),
		'image': site_url ~ asset('images/profile-share.jpg'),
		'author': {
			'@type': 'Person',
			'@id': site_url ~ '/#yoann-georges',
			'name': 'Yoann Georges',
			'jobTitle': 'Guide de haute montagne UIAGM',
			'image': site_url ~ asset('images/profile-share.jpg'),
			'url': site_url ~ path('about'),
		},
		'about': {'@id': site_url ~ '/#guide'},
	}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}
	</script>
{% endblock %}
{% block body %}
	{% set is_en = app.request.locale == 'en' %}

	<main class="legal-page area-page">
		<div class="container legal-container">
			<h1>{{ (is_en ? page.titleEn : null) ?: page.title }}</h1>

			<a class="area-guide" href="{{ path('about') }}">
				<img src="{{ asset('images/profile-contact.webp') }}" alt="Yoann Georges, {% trans %}IFMGA mountain guide{% endtrans %}" width="96" height="90">
				<span>
					<strong>Yoann Georges</strong>
					{% trans %}IFMGA mountain guide{% endtrans %}
				</span>
			</a>

			{# l'éditeur de l'admin ne produit que des <h1> : on les passe en <h2> sous le titre de page #}
			<div class="legal-content">
				{{ ((is_en ? page.contentEn : null) ?: page.content)|replace({'<h1>': '<h2>', '</h1>': '</h2>'})|raw }}
			</div>

			<h2 class="area-title">{% trans %}Activities{% endtrans %}</h2>
			<ul class="pricing-list">
				{% for disci in disciplines %}
					<li>
						<a class="pricing-item" href="{{ path('detail', {id: disci.id, slug: disci.slug(app.request.locale)}) }}">
							<h3>{{ is_en ? disci.englishTitle : disci.title }}</h3>
							<span class="pricing-item-more">{% trans %}See the activity{% endtrans %}</span>
						</a>
					</li>
				{% endfor %}
			</ul>

			{% set other_areas = area_pages()|filter(area => area.slug != page.slug) %}
			{% if other_areas %}
				<p class="area-others">
					{% trans %}Other areas:{% endtrans %}
					{% for area in other_areas %}
						<a href="{{ path('area_page', {slug: area.slug(app.request.locale)}) }}">{{ area.name }}</a>{{ not loop.last ? ', ' }}
					{% endfor %}
				</p>
			{% endif %}

			<div class="pricing-cta">
				<p>{% trans %}A project in mind? I will send you a personalised quote.{% endtrans %}</p>
				<a class="btn more-link" href="#contact-form">{% trans %}Contact me{% endtrans %}</a>
				<p class="area-prices"><a href="{{ path('pricing') }}">{% trans %}See all prices{% endtrans %}</a></p>
			</div>
		</div>
	</main>

	<div class="contact" id="contact-form">
		{% include "contact.html.twig" %}
		{% include "footer.html.twig" %}
	</div>
{% endblock %}
